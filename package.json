{
  "name": "orca-profiles",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm sample && vite",
    "sample": "pnpm fixture && node scripts/build-sample.mjs",
    "build": "pnpm sample && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "oxlint src",
    "test": "pnpm fixture && vitest run",
    "gates": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "smoke": "playwright test e2e/smoke.spec.ts e2e/read-bench.spec.ts",
    "report": "node scripts/build-report.mjs && node dist-cli/report.mjs",
    "docker:build": "docker build -t orca-profiles:latest .",
    "docker:run": "docker run --rm -p 127.0.0.1:8099:8099 -v \"${ORCA_CONFIG:-$HOME/.config/OrcaSlicer}:/config:ro\" --read-only --security-opt no-new-privileges:true orca-profiles:latest",
    "test:server": "playwright test e2e/server.spec.ts",
    "deploy": "./scripts/deploy.sh",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "fixture": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.75.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "Read-only explorer for OrcaSlicer preset inheritance"
}