# Copy to deploy.env (gitignored) and edit. Used by ./scripts/deploy.sh.

# The machine that holds the OrcaSlicer config — an ssh host alias.
ORCA_HOST=workshop

# Absolute path to the OrcaSlicer config directory ON THAT MACHINE.
ORCA_CONFIG=/home/you/.config/OrcaSlicer

# Where to publish. 127.0.0.1 keeps it to that machine; a LAN or tailnet
# address exposes it. Prefer naming an interface over 0.0.0.0 — on a docker
# host that also publishes onto every bridge network.
ORCA_BIND=127.0.0.1
ORCA_PORT=8099

# Optional: where this script should reach the deployment to verify it. Needed
# only when the bind address is not reachable from where you run the deploy.
#ORCA_VERIFY_URL=http://192.0.2.10:8099

# Where the source is mirrored on the target.
#ORCA_REMOTE_DIR=/home/you/apps/orca-profiles
